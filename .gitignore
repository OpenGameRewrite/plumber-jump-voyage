!/AGENTS.md
!/src/
/src/*
!/src/*.rs
!/src/tests/
/src/tests/*
!/src/tests/*.rs
!/tools/
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/*.cs
!/docs/
/docs/*
!/docs/*.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
**/__pycache__/
**/local/
**/assets/
**/*.nsp
**/*.xci
**/*.nca
**/*.keys
**/*.bfres
**/*.szs
**/*.glb
**/*.gltf
**/*.blend
**/*.png
**/*.jpg
